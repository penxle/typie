{
  "name": "@typie/styled-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "import": "./styled-system/css/index.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "import": "./styled-system/patterns/index.js"
    },
    "./presets": "./src/presets.generated.ts",
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "import": "./styled-system/tokens/index.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts",
      "import": "./styled-system/types/index.js"
    }
  },
  "scripts": {
    "codegen": "panda codegen",
    "generate": "node scripts/generate-theme.ts",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@pandacss/preset-base": "^1.12.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.12.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.4.0",
    "@typie/tsconfig": "workspace:*",
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
