{
  "name": "@typie/tsconfig",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./tsconfig.json",
    "./node": "./tsconfig.node.json"
  },
  "scripts": {
    "lint:prettier": "prettier --check --ignore-unknown --ignore-path ../../.gitignore --ignore-path ../../.prettierignore '**/*'",
    "lint:spellcheck": "cspell --no-progress --no-must-find-files --relative '**/*'"
  }
}
