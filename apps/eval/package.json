{
  "name": "@typie/eval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/wrap-worker.mjs",
    "codegen": "svelte-kit sync && panda codegen",
    "db:migrate": "wrangler d1 migrations apply typie-eval-beta --remote",
    "deploy": "vite build && node scripts/wrap-worker.mjs && wrangler deploy",
    "dev": "vite dev",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:svelte": "svelte-check --fail-on-warnings",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@iconify-json/lucide": "^1.2.127",
    "@pandacss/dev": "^1.12.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "@typie/lib": "workspace:*",
    "@typie/styled-system": "workspace:*",
    "@typie/tsconfig": "workspace:*",
    "@typie/ui": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.2"
  }
}
