{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "apiUrl": "https://turbo.penxle.io",
    "teamSlug": "typie"
  },
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["apps/api/schema.graphql", "assets/theme.json", "assets/themes/**"],
  "tasks": {
    "codegen": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", ".mearie/**", "styled-system/**"]
    },
    "build": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["codegen"],
      "persistent": true,
      "cache": false
    },
    "@typie/lintconfig#lintconfig": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/prettier.config.js"
      ]
    },
    "lint:eslint": {
      "dependsOn": ["codegen", "@typie/lintconfig#lintconfig"]
    },
    "lint:prettier": {
      "dependsOn": ["@typie/lintconfig#lintconfig"]
    },
    "//#lint:prettier:root": {
      "dependsOn": ["@typie/lintconfig#lintconfig"]
    },
    "lint:spellcheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.gitignore", "$TURBO_ROOT$/cspell.json", "$TURBO_ROOT$/cspell.txt"]
    },
    "//#lint:spellcheck:root": {},
    "lint:svelte": {
      "dependsOn": ["^codegen", "codegen"]
    },
    "lint:typecheck": {
      "dependsOn": ["codegen"]
    },
    "test": {
      "dependsOn": ["codegen"],
      "outputs": ["coverage/**"]
    }
  }
}
